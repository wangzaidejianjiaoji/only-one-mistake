{
  "description": "Optional EvolveFlow lifecycle companion; host review and trust required.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('node:path');const r=require('node:child_process').spawnSync(process.execPath,[p.join(process.env.PLUGIN_ROOT||process.env.CLAUDE_PLUGIN_ROOT,'src','cli.ts'),'hook'],{stdio:'inherit'});process.exit(r.status??1)\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 3
          }
        ]
      }
    ],
